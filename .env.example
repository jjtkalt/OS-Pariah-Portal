# Configuration file
#
# Local developers only: Modify and save this as .env
#
# Database Bootstrapping
OS_PARIAH_DB_HOST=127.0.0.1
OS_PARIAH_DB_USER=os-pariah
OS_PARIAH_DB_PASS=ChangeMe-LocalDev
OS_PARIAH_DB_NAME=os_pariah

# DATABASE ROBUST (OpenSim) - READ only
ROBUST_DB_HOST=127.0.0.1
ROBUST_DB_USER=robust_ro
ROBUST_DB_PASS=R0bustT3st
ROBUST_DB_NAME=robust

# Secret Keys
# Production: leave SECRET_KEY unset. It is auto-generated on first start into
# /etc/os-pariah/secrets (see scripts/ensure_secrets.py) so every install gets a
# strong, unique key. Do NOT ship a shared key in this file.
# Local dev only: uncomment and set your own value (not recommended), or let
# scripts/migrate.py generate a project-root .secrets file for you (recommended).
# SECRET_KEY=change-me-for-local-dev-only

# Bootstrap admin (recommended for first install):
# Grant portal Super Admin to a specific OpenSim PrincipalID on every migrate.
# This is the supported bootstrap path (userLevel >= 250 alone is not enough).
# See scripts/migrate.py and docs/NAMING.md.
# ADMIN_UUID=

# Ticket attachment storage (private; served only via /tickets/<id>/attachment/<file>
# after an ownership/staff check — never under app/static). Default:
#   /var/lib/os-pariah/uploads/tickets when /var/lib/os-pariah exists (packaged install),
#   otherwise <project>/instance/uploads/tickets for local development.
# OS_PARIAH_UPLOAD_FOLDER=
