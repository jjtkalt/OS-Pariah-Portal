Cmnd_Alias OS_PARIAH_CONTROL = /bin/systemctl start os-pariah-worker-iar.service
Cmnd_Alias OS_PARIAH_SECURE = /opt/os-pariah/venv/bin/python /opt/os-pariah/scripts/sync_firewall.py, /opt/os-pariah/venv/bin/python /opt/os-pariah/scripts/sync_robust.py
Cmnd_Alias OPENSIMCTL = /bin/systemctl start opensim@*.service, /bin/systemctl stop opensim@*.service, /bin/systemctl restart opensim@*.service, /bin/systemctl enable opensim@*.service, /bin/systemctl disable opensim@*.service
Cmnd_Alias OPENSIMSCREEN = /usr/bin/screen -p 0 -S OpenSim-* -X stuff *
Cmnd_Alias ROBUSTCTL = /bin/systemctl start robust@*.service, /bin/systemctl stop robust@*.service, /bin/systemctl restart robust@*.service, /bin/systemctl enable robust@*.service, /bin/systemctl disable robust@*.service

os-pariah ALL=(ALL) NOPASSWD: OS_PARIAH_CONTROL, OS_PARIAH_SECURE, OPENSIMCTL, ROBUSTCTL
os-pariah ALL=(opensim) NOPASSWD: OPENSIMSCREEN
